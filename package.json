{
  "name": "affine",
  "displayName": "AFFiNE by MasteryHub",
  "description": "MasteryHub ITS client for AFFiNE — browse, preview, and organize self-hosted or Cloud pages inside VS Code and Cursor.",
  "version": "1.1.0",
  "publisher": "MasteryHubITS",
  "license": "MIT",
  "author": "MasteryHub ITS",
  "private": false,
  "packageManager": "npm@11.6.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/masteryhub-its/affine-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/masteryhub-its/affine-vscode-extension/issues"
  },
  "homepage": "https://github.com/masteryhub-its/affine-vscode-extension#readme",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Notebooks",
    "Other"
  ],
  "galleryBanner": {
    "color": "#181818",
    "theme": "dark"
  },
  "keywords": [
    "affine",
    "notes",
    "wiki",
    "self-hosted",
    "masteryhub",
    "vscode-extension",
    "cursor"
  ],
  "icon": "media/affine.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "configuration": {
      "title": "AFFiNE",
      "properties": {
        "affine.serverUrl": {
          "type": "string",
          "default": "https://app.affine.pro",
          "scope": "application",
          "description": "Base URL of the AFFiNE instance (Global only — workspace/folder settings are ignored so a cloned repo cannot retarget your token). Use https://app.affine.pro for AFFiNE Cloud, or your self-hosted URL (no trailing slash)."
        },
        "affine.defaultWorkspaceId": {
          "type": "string",
          "default": "",
          "description": "Optional workspace id used as the default search/open target. Empty uses every accessible workspace."
        },
        "affine.openMode": {
          "type": "string",
          "enum": [
            "external"
          ],
          "default": "external",
          "description": "How to open an AFFiNE document. Always uses your system browser. Cursor Simple Browser has no AFFiNE login session, so it shows “you do not have access”."
        },
        "affine.clientVersion": {
          "type": "string",
          "default": "0.26.0",
          "description": "Value of the x-affine-client-version request header. Must be >= 0.26.0 so websocket sync (move and trash) is accepted."
        },
        "affine.ui.legacySidebar": {
          "type": "boolean",
          "default": false,
          "description": "Show the previous webview panel (account, server and recent-pages cards) above the Pages tree. Off by default: the Pages tree now has the sign-in, search and server actions in its title bar."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "affine",
          "title": "AFFiNE",
          "icon": "media/affine-mark.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "affine.openSignIn",
        "title": "Sign in to AFFiNE"
      },
      {
        "command": "affine.search",
        "title": "Search AFFiNE Pages",
        "icon": "$(search)"
      },
      {
        "command": "affine.openDocument",
        "title": "Open AFFiNE Document"
      },
      {
        "command": "affine.refresh",
        "title": "Sync AFFiNE",
        "icon": "$(sync)"
      },
      {
        "command": "affine.forceReload",
        "title": "Force Reload AFFiNE",
        "icon": "$(debug-restart)"
      },
      {
        "command": "affine.signOut",
        "title": "Sign out of AFFiNE",
        "icon": "$(sign-out)"
      },
      {
        "command": "affine.deleteDocument",
        "title": "Move to Trash",
        "icon": "$(trash)"
      },
      {
        "command": "affine.moveDocument",
        "title": "Move to Folder",
        "icon": "$(files)"
      },
      {
        "command": "affine.createPage",
        "title": "New AFFiNE Page",
        "icon": "$(add)"
      },
      {
        "command": "affine.sendSelectionToPage",
        "title": "Send Selection to AFFiNE Page",
        "icon": "$(book)"
      },
      {
        "command": "affine.openAsMarkdown",
        "title": "Open Page as Markdown",
        "icon": "$(markdown)"
      },
      {
        "command": "affine.createFolder",
        "title": "New Organize Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "affine.restoreDocument",
        "title": "Restore from Trash",
        "icon": "$(discard)"
      },
      {
        "command": "affine.renameDocument",
        "title": "Rename Page",
        "icon": "$(edit)"
      },
      {
        "command": "affine.duplicateDocument",
        "title": "Duplicate Page",
        "icon": "$(copy)"
      },
      {
        "command": "affine.openLink",
        "title": "Open AFFiNE Link"
      },
      {
        "command": "affine.setServerUrl",
        "title": "Set AFFiNE Server URL",
        "icon": "$(server)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "affine.deleteDocument",
          "when": "false"
        },
        {
          "command": "affine.moveDocument",
          "when": "false"
        },
        {
          "command": "affine.renameDocument",
          "when": "false"
        },
        {
          "command": "affine.duplicateDocument",
          "when": "false"
        },
        {
          "command": "affine.sendSelectionToPage",
          "when": "editorHasSelection && affine.signedIn"
        },
        {
          "command": "affine.openAsMarkdown",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "affine.search",
          "when": "view == affinePanel",
          "group": "navigation@0"
        },
        {
          "command": "affine.createPage",
          "when": "view == affinePanel",
          "group": "navigation@1"
        },
        {
          "command": "affine.forceReload",
          "when": "view == affinePanel",
          "group": "navigation@2"
        },
        {
          "command": "affine.refresh",
          "when": "view == affinePanel",
          "group": "navigation@3"
        },
        {
          "command": "affine.signOut",
          "when": "(view == affinePanel) && affine.signedIn",
          "group": "navigation@4"
        },
        {
          "command": "affine.search",
          "when": "view == affineExplorer",
          "group": "navigation@0"
        },
        {
          "command": "affine.createPage",
          "when": "view == affineExplorer && affine.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "affine.createFolder",
          "when": "view == affineExplorer && affine.signedIn",
          "group": "navigation@2"
        },
        {
          "command": "affine.refresh",
          "when": "view == affineExplorer",
          "group": "1_more@1"
        },
        {
          "command": "affine.forceReload",
          "when": "view == affineExplorer",
          "group": "1_more@2"
        },
        {
          "command": "affine.restoreDocument",
          "when": "view == affineExplorer && affine.signedIn",
          "group": "1_more@3"
        },
        {
          "command": "affine.setServerUrl",
          "when": "view == affineExplorer",
          "group": "1_more@4"
        },
        {
          "command": "affine.signOut",
          "when": "view == affineExplorer && affine.signedIn",
          "group": "1_more@5"
        }
      ],
      "view/item/context": [
        {
          "command": "affine.moveDocument",
          "when": "view == affineExplorer && viewItem == affineDocument",
          "group": "1_organize@1"
        },
        {
          "command": "affine.renameDocument",
          "when": "view == affineExplorer && viewItem == affineDocument",
          "group": "1_organize@2"
        },
        {
          "command": "affine.duplicateDocument",
          "when": "view == affineExplorer && viewItem == affineDocument",
          "group": "1_organize@3"
        },
        {
          "command": "affine.deleteDocument",
          "when": "view == affineExplorer && viewItem == affineDocument",
          "group": "1_organize@4"
        },
        {
          "command": "affine.openAsMarkdown",
          "when": "view == affineExplorer && viewItem == affineDocument"
        }
      ],
      "editor/context": [
        {
          "command": "affine.openLink",
          "when": "editorHasSelection || editorTextFocus",
          "group": "navigation@9"
        },
        {
          "command": "affine.sendSelectionToPage",
          "when": "editorHasSelection && affine.signedIn",
          "group": "affine@1"
        }
      ]
    },
    "views": {
      "affine": [
        {
          "type": "webview",
          "id": "affinePanel",
          "name": "AFFiNE",
          "visibility": "visible",
          "when": "config.affine.ui.legacySidebar"
        },
        {
          "id": "affineExplorer",
          "name": "Pages",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "affineExplorer",
        "contents": "Sign in to browse and preview your AFFiNE pages beside your code.\n[Sign in](command:affine.openSignIn)\n[Choose server](command:affine.setServerUrl)\nYour credentials stay in the editor's secret storage and are only sent to the server you choose.",
        "when": "!affine.signedIn"
      }
    ]
  },
  "scripts": {
    "compile": "rm -rf dist && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "vscode:prepublish": "npm run compile",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \".prettierrc\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"package.json\" \".prettierrc\"",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.eslint.json --noEmit",
    "test": "jest --ci",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm test",
    "package": "npm run compile && vsce package --no-dependencies",
    "screenshots": "esbuild scripts/capture-screenshots.ts --bundle --platform=node --format=cjs --outfile=/tmp/affine-capture-screenshots.js && node /tmp/affine-capture-screenshots.js"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "jest": "^30.0.0",
    "ovsx": "^0.10.6",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "fractional-indexing": "2.0.0",
    "socket.io-client": "^4.8.3",
    "yjs": "^13.6.32"
  }
}
